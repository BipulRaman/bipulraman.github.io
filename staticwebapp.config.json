{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/assets/*", "/styles/*", "/scripts/*", "*.{svg,png,jpg,webp,ico,webmanifest}"]
  },
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "X-Frame-Options": "DENY",
    "Referrer-Policy": "strict-origin-when-cross-origin",
    "Permissions-Policy": "geolocation=(), microphone=(), camera=()"
  },
  "routes": [
    {
      "route": "/assets/fonts/*",
      "headers": { "Cache-Control": "public, max-age=31536000, immutable" }
    },
    {
      "route": "/assets/*",
      "headers": { "Cache-Control": "public, max-age=31536000, immutable" }
    },
    {
      "route": "/styles/*",
      "headers": { "Cache-Control": "public, max-age=31536000, immutable" }
    },
    {
      "route": "/scripts/*",
      "headers": { "Cache-Control": "public, max-age=31536000, immutable" }
    },
    {
      "route": "/*.{svg,png,jpg,jpeg,webp,ico,webmanifest}",
      "headers": { "Cache-Control": "public, max-age=31536000, immutable" }
    },
    {
      "route": "/index.html",
      "headers": { "Cache-Control": "public, max-age=300, must-revalidate" }
    },
    {
      "route": "/",
      "headers": { "Cache-Control": "public, max-age=300, must-revalidate" }
    }
  ],
  "mimeTypes": {
    ".svg": "image/svg+xml",
    ".webp": "image/webp",
    ".woff2": "font/woff2"
  }
}
